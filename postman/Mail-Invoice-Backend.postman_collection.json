{
  "info": {
    "_postman_id": "e2f1a5f6-2c1f-49d9-9b8e-9e3a2e5b8b72",
    "name": "Mail-Invoice Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/healthz" }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [ {"key":"Content-Type","value":"application/json"} ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/signup"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [ {"key":"Content-Type","value":"application/json"} ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Google Status",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/google/status" }
        },
        {
          "name": "Google Start (redirect)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/google" },
          "response": []
        }
      ]
    },
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Create Account",
          "request": {
            "method": "POST",
            "header": [ {"key":"Content-Type","value":"application/json"} ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"IMAP\",\n  \"email\": \"invoices@example.com\",\n  \"status\": \"pending\",\n  \"meta\": {\n    \"host\": \"imap.example.com\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/accounts"
          }
        },
        {
          "name": "List Accounts",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/accounts" }
        },
        {
          "name": "Get Account",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/accounts/:id", "host":["{{baseUrl}}"], "path":["api","accounts", ":id"], "variable":[{"key":"id","value":"00000000-0000-0000-0000-000000000000"}] } }
        },
        {
          "name": "Update Account",
          "request": {
            "method": "PUT",
            "header": [ {"key":"Content-Type","value":"application/json"} ],
            "body": { "mode":"raw", "raw": "{\n  \"status\": \"connected\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/accounts/:id", "host":["{{baseUrl}}"], "path":["api","accounts", ":id"], "variable":[{"key":"id","value":"00000000-0000-0000-0000-000000000000"}] }
          }
        },
        {
          "name": "Delete Account",
          "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/api/accounts/:id", "host":["{{baseUrl}}"], "path":["api","accounts", ":id"], "variable":[{"key":"id","value":"00000000-0000-0000-0000-000000000000"}] } }
        }
      ]
    },
    {
      "name": "Invoices",
      "item": [
        {
          "name": "List Invoices",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/invoices" }
        },
        {
          "name": "Get Invoice",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/invoices/:id", "host":["{{baseUrl}}"], "path":["api","invoices", ":id"], "variable":[{"key":"id","value":"00000000-0000-0000-0000-000000000000"}] } }
        },
        {
          "name": "Trigger IMAP Fetch",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/invoices/fetch" }
        }
      ]
    }
  ]
}
